{
  "expo": {
    "name": "RM Roost",
    "slug": "rider-app",
    "version": "1.0.21",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rider-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rockymountain.riderapp",
      "appleTeamId": "3ZTSW3FGZ3",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Use Face ID to sign in to RM Roost quickly and securely."
      },
      "buildNumber": "6"
    },
    "android": {
      "package": "com.rockymountain.riderapp",
      "versionCode": 24,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://www.rmroost.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-local-authentication",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RM Roost uses your location to show races near you and to confirm you're at the track for Quick Check-In.",
          "locationAlwaysAndWhenInUsePermission": "RM Roost uses your location in the background on race day to notify you when you arrive at the track, so you can check in from your phone and skip the line.",
          "locationAlwaysPermission": "RM Roost uses your location in the background on race day to notify you when you arrive at the track, so you can check in from your phone and skip the line.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#B30000"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "97b8d6d6-ed00-43d6-8c64-128a8c2b6800"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/rider-app"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/97b8d6d6-ed00-43d6-8c64-128a8c2b6800",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
