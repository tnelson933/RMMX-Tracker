{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "pnpm": "10.26.1",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "rmmx-tracker.replit.app"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "ios": {
        "simulator": false,
        "credentialsSource": "remote"
      }
    },
    "production": {
      "node": "20.19.4",
      "pnpm": "10.26.1",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "rmmx-tracker.replit.app"
      },
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-54",
        "credentialsSource": "remote"
      },
      "ios": {
        "autoIncrement": true,
        "image": "macos-sequoia-15.6-xcode-16.4",
        "credentialsSource": "remote"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "production"
      },
      "ios": {
        "ascAppId": "6791718924"
      }
    }
  }
}
