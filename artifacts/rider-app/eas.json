{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "pnpm": "10.26.1",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "ios": {
        "simulator": true
      },
      "channel": "development"
    },
    "preview": {
      "pnpm": "10.26.1",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "www.rmroost.com"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "ios": {
        "simulator": false,
        "credentialsSource": "remote"
      },
      "channel": "preview"
    },
    "production": {
      "node": "20.19.4",
      "pnpm": "10.26.1",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "www.rmroost.com"
      },
      "android": {
        "autoIncrement": true,
        "buildType": "app-bundle",
        "image": "sdk-54",
        "credentialsSource": "remote"
      },
      "ios": {
        "autoIncrement": true,
        "image": "macos-sequoia-15.6-xcode-26.0",
        "credentialsSource": "local"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6791718924"
      }
    }
  }
}
