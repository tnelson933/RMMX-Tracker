# Local development config for scripts/dev-local.mjs.
# Copy to `.env` (gitignored) and fill in. NEVER point DATABASE_URL at production.

# Disposable local PostgreSQL database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rmtracker_dev

# Generate a random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

NODE_ENV=development
API_PORT=8080
WEB_PORT=19869
BASE_PATH=/
# Used for emailed/returned links (setup, reset, registration)
APP_URL=http://127.0.0.1:19869

# The API crashes at boot if these four are missing (imported eagerly).
# Placeholders let it start; AI/TTS routes will fail until real values are set.
# For a direct Anthropic key, the base URL would be https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=http://127.0.0.1:9/anthropic-not-configured
AI_INTEGRATIONS_ANTHROPIC_API_KEY=not-configured
AI_INTEGRATIONS_OPENAI_BASE_URL=http://127.0.0.1:9/openai-not-configured
AI_INTEGRATIONS_OPENAI_API_KEY=not-configured

# Optional. Without RESEND_API_KEY, setup/reset links are logged to the API console instead of emailed.
# RESEND_API_KEY=
# EMAIL_FROM=
# Optional. Use Stripe TEST-mode keys only for local dev.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
