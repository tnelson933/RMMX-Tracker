{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/Dockerfile.railway",
    "watchPatterns": ["artifacts/api-server/**", "artifacts/race-platform/**", "lib/**", "scripts/**", "deploy/Dockerfile.railway", "pnpm-lock.yaml", "pnpm-workspace.yaml", "package.json", "railway.json"]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/api/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
