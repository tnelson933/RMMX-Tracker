# Server config for deploy/docker-compose.yml. Copy to deploy/.env (gitignored).
# Never commit real values. Generate random values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Core (required) ---
# Hex/alphanumeric only (it is embedded in the database URL).
POSTGRES_PASSWORD=
SESSION_SECRET=
# The address people use to reach the site, e.g. http://192.168.1.50 or https://tracker.example.com
APP_URL=
# ":80" = plain HTTP on the LAN. Later: your domain (e.g. tracker.example.com) for automatic HTTPS.
SITE_ADDRESS=:80
# Must be false while serving plain HTTP, or logins will not stick. Remove once HTTPS is on.
COOKIE_SECURE=false
LOG_LEVEL=info

# --- AI (Rocky, AI mechanic, points-table AI, announcer voice) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Payments: use TEST-mode keys on a test server ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional: only if you add a webhook endpoint (https://<site>/api/stripe/webhook) in Stripe
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend). Leave blank on a test server: setup/reset links are logged instead of sent ---
RESEND_API_KEY=
EMAIL_FROM=
